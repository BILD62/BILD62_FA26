   "source": [
    "<div class=\"alert alert-success\">\n",
    "    <b>Task:</b> In breakout groups, work together to trace the <code>create_complement_string()</code> function in the cell below. For each numbered in-line comment (beginning with the # symbol), write a brief description of that line of code.    \n",
    "</div>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "cd8b2b24-dea2-45de-9b4e-2249f6645f18",
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_complement_string(DNA): #1 \n",
    "    \n",
    "    \"\"\"Creates complement DNA from a template strand         \n",
    "\n",
    "    Loops through bases in DNA template and constructs a\n",
    "    new DNA strand built from complementary bases.\n",
    "\n",
    "    Args:\n",
    "        DNA (str): Template DNA strand\n",
    "\n",
    "    Returns:\n",
    "        complement_DNA (str): Complementary DNA strand\n",
    "    \"\"\" #2 <--- What is this type of string called?\n",
    "    \n",
    "    complement_DNA = \"\" #3\n",
    "    \n",
    "    DNA = DNA.upper() #Makes sure DNA is upper-case\n",
    "    for idx in range(len(DNA)): #4\n",
    "        base = DNA[idx]         #5\n",
    "        if base == 'A':         #6\n",
    "            complement_DNA += 'T' #Adds 'T' to complement_DNA (shorthand for complement_DNA = complement_DNA + 'T') \n",
    "        elif base == 'C':       \n",
    "            complement_DNA += 'G'\n",
    "        elif base == 'T':       \n",
    "            complement_DNA += 'A'\n",
    "        elif base == 'G':        \n",
    "            complement_DNA += 'C'\n",
    "        else:                    #7\n",
    "            print(f'Invalid Base at position {idx + 1}') #If DNA contains an invalid base, this statement prints along with the base's location\n",
    "            complement_DNA += 'X' #8\n",
    "    return complement_DNA #9\n",
    "    "
   ]
  },
